#!/usr/bin/env python3
"""
main.py — Sobe o projeto atual para um repositório no GitHub.

O que ele faz:
  1. Inicializa o git no diretório atual (se ainda não estiver inicializado).
  2. Cria um .gitignore básico (se não existir).
  3. Cria o repositório no GitHub via API (se ainda não existir).
  4. Faz add + commit + push de tudo para o branch principal.

Requisitos:
  - Python 3.8+
  - git instalado e configurado (git config --global user.name/user.email)
  - Um Personal Access Token do GitHub com permissão "repo"
    -> https://github.com/settings/tokens (classic) ou um "fine-grained token"

Como usar:
  1. Defina as variáveis de ambiente (ou edite o bloco CONFIG abaixo):
       set GITHUB_TOKEN=seu_token          (Windows, cmd)
       $env:GITHUB_TOKEN="seu_token"       (Windows, PowerShell)
       export GITHUB_TOKEN=seu_token       (Mac/Linux)

  2. Rode:
       python main.py --repo nome-do-repositorio --username seu_usuario

  Parâmetros opcionais:
       --private        cria o repositório como privado (padrão: público)
       --branch nome     nome do branch principal (padrão: main)
       --message "msg"   mensagem do commit (padrão: "Deploy inicial")
"""

import argparse
import json
import os
import subprocess
import sys
import urllib.request
import urllib.error


def run(cmd, check=True):
    """Executa um comando e mostra a saída em tempo real."""
    print(f"$ {' '.join(cmd)}")
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.stdout:
        print(result.stdout.strip())
    if result.stderr:
        print(result.stderr.strip())
    if check and result.returncode != 0:
        sys.exit(f"Erro ao executar: {' '.join(cmd)}")
    return result


def repo_exists(username, repo, token):
    req = urllib.request.Request(
        f"https://api.github.com/repos/{username}/{repo}",
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
        },
    )
    try:
        urllib.request.urlopen(req)
        return True
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return False
        raise


def create_repo(repo, token, private):
    payload = json.dumps({
        "name": repo,
        "private": private,
        "auto_init": False,
    }).encode()

    req = urllib.request.Request(
        "https://api.github.com/user/repos",
        data=payload,
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github+json",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req) as resp:
            data = json.loads(resp.read())
            print(f"Repositório criado: {data['html_url']}")
    except urllib.error.HTTPError as e:
        sys.exit(f"Erro ao criar repositório ({e.code}): {e.read().decode()}")


def ensure_gitignore():
    if not os.path.exists(".gitignore"):
        with open(".gitignore", "w") as f:
            f.write("__pycache__/\n.env\n.DS_Store\nnode_modules/\n*.log\n")
        print("Arquivo .gitignore criado.")


def main():
    parser = argparse.ArgumentParser(description="Sobe o projeto atual para o GitHub.")
    parser.add_argument("--repo", required=True, help="Nome do repositório no GitHub")
    parser.add_argument("--username", required=True, help="Seu usuário/organização no GitHub")
    parser.add_argument("--branch", default="main", help="Nome do branch principal (padrão: main)")
    parser.add_argument("--message", default="Deploy inicial", help="Mensagem do commit")
    parser.add_argument("--private", action="store_true", help="Cria o repositório como privado")
    args = parser.parse_args()

    token = os.environ.get("GITHUB_TOKEN")
    if not token:
        sys.exit(
            "Defina a variável de ambiente GITHUB_TOKEN com um Personal Access Token do GitHub.\n"
            "Crie um em: https://github.com/settings/tokens"
        )

    ensure_gitignore()

    # Inicializa o git se necessário
    if not os.path.exists(".git"):
        run(["git", "init"])
        run(["git", "branch", "-M", args.branch])

    # Cria o repositório remoto se ainda não existir
    if not repo_exists(args.username, args.repo, token):
        create_repo(args.repo, token, args.private)
    else:
        print("Repositório já existe no GitHub, seguindo com o push.")

    remote_url = f"https://{args.username}:{token}@github.com/{args.username}/{args.repo}.git"

    # Configura (ou atualiza) o remote "origin"
    remotes = run(["git", "remote"], check=False).stdout.split()
    if "origin" in remotes:
        run(["git", "remote", "set-url", "origin", remote_url])
    else:
        run(["git", "remote", "add", "origin", remote_url])

    run(["git", "add", "."])
    commit = run(["git", "commit", "-m", args.message], check=False)
    if commit.returncode != 0:
        print("Nada novo para commitar (ou já commitado).")

    run(["git", "push", "-u", "origin", args.branch])

    print(f"\nProjeto disponível em: https://github.com/{args.username}/{args.repo}")


if __name__ == "__main__":
    main()
